    <changeSet id="synchronizationmr-20260914-patient-capture" author="sihsalus">
        <!-- Una fila por instalación: identidad del nodo y último número de paciente asignado.
             singleton_id siempre vale 1; node_uuid se genera al solicitarlo al DAO común y confirmar la transacción.
             patient_sequence empieza en 0 y aumenta con cada paciente nuevo capturado. -->
        <createTable tableName="synchronizationmr_local_node">
            <column name="singleton_id" type="int"><constraints primaryKey="true" nullable="false" /></column>
            <column name="node_uuid" type="varchar(38)"><constraints unique="true" /></column>
            <column name="patient_sequence" type="bigint"><constraints nullable="false" /></column>
        </createTable>
        <insert tableName="synchronizationmr_local_node">
            <column name="singleton_id" valueNumeric="1" />
            <column name="patient_sequence" valueNumeric="0" />
        </insert>
        <!-- Una fila por paciente capturado. patient_id enlaza al paciente local de OpenMRS;
             patient_uuid conserva su UUID nativo. origin_node_uuid y entity_sequence
             identifican su origen y número. El tipo PATIENT está implícito en esta tabla. -->
        <createTable tableName="synchronizationmr_patient_identity">
            <column name="patient_id" type="int"><constraints primaryKey="true" nullable="false" /></column>
            <column name="patient_uuid" type="varchar(38)"><constraints nullable="false" unique="true" /></column>
            <column name="origin_node_uuid" type="varchar(38)"><constraints nullable="false" /></column>
            <column name="entity_sequence" type="bigint"><constraints nullable="false" /></column>
        </createTable>
        <addUniqueConstraint tableName="synchronizationmr_patient_identity"
            columnNames="origin_node_uuid,entity_sequence" constraintName="syncmr_patient_origin_sequence_uq" />
        <addForeignKeyConstraint baseTableName="synchronizationmr_patient_identity" baseColumnNames="patient_id"
            referencedTableName="patient" referencedColumnNames="patient_id" constraintName="syncmr_patient_identity_fk" />
        <!-- Inicio de la cola persistente: un evento de creación por paciente en esta etapa.
             event_uuid identifica el evento; patient_id lo enlaza a la identidad anterior.
             operation = CREATE (creación), state = PENDING (pendiente), date_created = fecha.
             Todavía no contiene el contenido clínico a enviar ni administra envíos o reintentos. -->
        <createTable tableName="synchronizationmr_patient_event">
            <column name="event_uuid" type="varchar(38)"><constraints primaryKey="true" nullable="false" /></column>
            <column name="patient_id" type="int"><constraints nullable="false" unique="true" /></column>
            <column name="operation" type="varchar(16)"><constraints nullable="false" /></column>
            <column name="state" type="varchar(16)"><constraints nullable="false" /></column>
            <column name="date_created" type="datetime"><constraints nullable="false" /></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="synchronizationmr_patient_event" baseColumnNames="patient_id"
            referencedTableName="synchronizationmr_patient_identity" referencedColumnNames="patient_id"
            constraintName="syncmr_patient_event_fk" />
        <createIndex tableName="synchronizationmr_patient_event" indexName="syncmr_patient_event_state_idx">
            <column name="state" />
        </createIndex>
    </changeSet>
    <!-- Migración adicional: conserva las instalaciones y eventos de la versión anterior. -->
    <changeSet id="synchronizationmr-20260914-patient-payload-v1" author="sihsalus">
        <addColumn tableName="synchronizationmr_patient_event">
            <!-- JSON inmutable del evento y sus datos básicos. Los eventos antiguos quedan sin JSON;
                 no podemos reconstruir fielmente sus datos originales leyendo el paciente actual. -->
            <column name="payload_json" type="clob" />
        </addColumn>
    </changeSet>
    <changeSet id="synchronizationmr-20260914-patient-receipt" author="sihsalus">
        <!-- Confirmación consecutiva de pacientes recibidos por origen; no es el MAX de identidades. -->
        <createTable tableName="synchronizationmr_patient_receipt">
            <column name="origin_node_uuid" type="varchar(38)"><constraints primaryKey="true" nullable="false" /></column>
            <column name="confirmed_sequence" type="bigint"><constraints nullable="false" /></column>
        </createTable>
    </changeSet>
    <changeSet id="synchronizationmr-20260915-encounter-capture" author="sihsalus">
        <addColumn tableName="synchronizationmr_local_node">
            <column name="encounter_sequence" type="bigint" defaultValueNumeric="0"><constraints nullable="false" /></column>
        </addColumn>
        <!-- ENCOUNTER está implícito en esta tabla. Todavía no almacena el JSON clínico. -->
        <createTable tableName="synchronizationmr_encounter_event">
            <column name="event_uuid" type="varchar(38)"><constraints primaryKey="true" nullable="false" /></column>
            <column name="encounter_id" type="int"><constraints nullable="false" unique="true" /></column>
            <column name="encounter_uuid" type="varchar(38)"><constraints nullable="false" unique="true" /></column>
            <column name="patient_id" type="int"><constraints nullable="false" /></column>
            <column name="patient_uuid" type="varchar(38)"><constraints nullable="false" /></column>
            <column name="origin_node_uuid" type="varchar(38)"><constraints nullable="false" /></column>
            <column name="entity_sequence" type="bigint"><constraints nullable="false" /></column>
            <column name="operation" type="varchar(16)"><constraints nullable="false" /></column>
            <column name="state" type="varchar(16)"><constraints nullable="false" /></column>
            <column name="date_created" type="datetime"><constraints nullable="false" /></column>
        </createTable>
        <addUniqueConstraint tableName="synchronizationmr_encounter_event" columnNames="origin_node_uuid,entity_sequence" constraintName="syncmr_enc_origin_sequence_uq" />
        <addForeignKeyConstraint baseTableName="synchronizationmr_encounter_event" baseColumnNames="encounter_id" referencedTableName="encounter" referencedColumnNames="encounter_id" constraintName="syncmr_enc_event_enc_fk" />
        <addForeignKeyConstraint baseTableName="synchronizationmr_encounter_event" baseColumnNames="patient_id" referencedTableName="patient" referencedColumnNames="patient_id" constraintName="syncmr_enc_event_patient_fk" />
    </changeSet>
    <changeSet id="synchronizationmr-20260915-encounter-payload" author="sihsalus">
        <!-- Los eventos anteriores quedan sin JSON: no se reconstruye su historia automáticamente. -->
        <addColumn tableName="synchronizationmr_encounter_event"><column name="payload_json" type="clob" /></addColumn>
    </changeSet>
    <changeSet id="synchronizationmr-20260920-server-id" author="sihsalus">
        <!-- Vinculación adicional: no renombra UUID, secuencias ni eventos existentes.
             Se completa mediante la API Java al configurar la comunicación. -->
        <addColumn tableName="synchronizationmr_local_node">
            <column name="server_id" type="varchar(100)" />
        </addColumn>
    </changeSet>
    <changeSet id="synchronizationmr-20260920-server-id-only" author="sihsalus">
        <!-- Si hay historial previo se detiene: hace falta mapear esos orígenes explícitamente. -->
        <preConditions onFail="HALT" onError="HALT">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM synchronizationmr_patient_identity</sqlCheck>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM synchronizationmr_patient_event</sqlCheck>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM synchronizationmr_encounter_event</sqlCheck>
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM synchronizationmr_patient_receipt</sqlCheck>
        </preConditions>
        <!-- En una instalación nueva las tablas de sincronización están vacías.
             El historial antiguo requiere una migración explícita; no se elimina.
             No se tocan las tablas clínicas ni se modifica ningún changeset anterior. -->
        <dropColumn tableName="synchronizationmr_local_node" columnName="node_uuid" />
        <renameColumn tableName="synchronizationmr_patient_identity" oldColumnName="origin_node_uuid" newColumnName="origin_server_id" columnDataType="varchar(100)" />
        <modifyDataType tableName="synchronizationmr_patient_identity" columnName="origin_server_id" newDataType="varchar(100)" />
        <renameColumn tableName="synchronizationmr_encounter_event" oldColumnName="origin_node_uuid" newColumnName="origin_server_id" columnDataType="varchar(100)" />
        <modifyDataType tableName="synchronizationmr_encounter_event" columnName="origin_server_id" newDataType="varchar(100)" />
        <renameColumn tableName="synchronizationmr_patient_receipt" oldColumnName="origin_node_uuid" newColumnName="origin_server_id" columnDataType="varchar(100)" />
        <modifyDataType tableName="synchronizationmr_patient_receipt" columnName="origin_server_id" newDataType="varchar(100)" />
    </changeSet>
    <changeSet id="synchronizationmr-20260920-server-id-collation" author="sihsalus" dbms="mysql,mariadb">
        <!-- Comparación exacta y orden idéntico al de Java para nombres ASCII y paginación. -->
        <sql>ALTER TABLE synchronizationmr_local_node MODIFY server_id VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NULL</sql>
        <sql>ALTER TABLE synchronizationmr_patient_identity MODIFY origin_server_id VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL</sql>
        <sql>ALTER TABLE synchronizationmr_encounter_event MODIFY origin_server_id VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL</sql>
        <sql>ALTER TABLE synchronizationmr_patient_receipt MODIFY origin_server_id VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL</sql>
    </changeSet>
    <changeSet id="synchronizationmr-20260920-encounter-receipt" author="sihsalus">
        <createTable tableName="synchronizationmr_encounter_receipt">
            <column name="origin_server_id" type="varchar(100)"><constraints primaryKey="true" nullable="false" /></column>
            <column name="confirmed_sequence" type="bigint"><constraints nullable="false" /></column>
        </createTable>
    </changeSet>
    <changeSet id="synchronizationmr-20260920-encounter-receipt-collation" author="sihsalus" dbms="mysql,mariadb">
        <sql>ALTER TABLE synchronizationmr_encounter_receipt MODIFY origin_server_id VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL</sql>
    </changeSet>
    <changeSet id="synchronizationmr-20260920-order-capture" author="sihsalus">
        <addColumn tableName="synchronizationmr_local_node">
            <column name="order_sequence" type="bigint" defaultValueNumeric="0"><constraints nullable="false" /></column>
        </addColumn>
        <!-- ENCOUNTER está implícito en esta tabla. Todavía no almacena el JSON clínico. -->
        <createTable tableName="synchronizationmr_order_event">
            <column name="event_uuid" type="varchar(38)"><constraints primaryKey="true" nullable="false" /></column>
            <column name="order_id" type="int"><constraints nullable="false" unique="true" /></column>
            <column name="order_uuid" type="varchar(38)"><constraints nullable="false" unique="true" /></column>
            <column name="patient_id" type="int"><constraints nullable="false" /></column>
            <column name="patient_uuid" type="varchar(38)"><constraints nullable="false" /></column>
            <column name="origin_server_id" type="varchar(100)"><constraints nullable="false" /></column>
            <column name="entity_sequence" type="bigint"><constraints nullable="false" /></column>
            <column name="operation" type="varchar(16)"><constraints nullable="false" /></column>
            <column name="state" type="varchar(16)"><constraints nullable="false" /></column>
            <column name="date_created" type="datetime"><constraints nullable="false" /></column>
        </createTable>
        <addUniqueConstraint tableName="synchronizationmr_order_event" columnNames="origin_server_id,entity_sequence" constraintName="syncmr_ord_origin_sequence_uq" />
        <addForeignKeyConstraint baseTableName="synchronizationmr_order_event" baseColumnNames="order_id" referencedTableName="orders" referencedColumnNames="order_id" constraintName="syncmr_ord_event_enc_fk" />
        <addForeignKeyConstraint baseTableName="synchronizationmr_order_event" baseColumnNames="patient_id" referencedTableName="patient" referencedColumnNames="patient_id" constraintName="syncmr_ord_event_patient_fk" />
    </changeSet>
    <changeSet id="synchronizationmr-20260920-order-payload" author="sihsalus">
        <!-- Los eventos anteriores quedan sin JSON: no se reconstruye su historia automáticamente. -->
        <addColumn tableName="synchronizationmr_order_event"><column name="payload_json" type="clob" /></addColumn>
    </changeSet>
    <changeSet id="synchronizationmr-20260920-order-receipt-links" author="sihsalus">
        <createTable tableName="synchronizationmr_order_receipt">
            <column name="origin_server_id" type="varchar(100)"><constraints primaryKey="true" nullable="false" /></column>
            <column name="confirmed_sequence" type="bigint"><constraints nullable="false" /></column>
        </createTable>
        <createTable tableName="synchronizationmr_order_link">
            <column name="link_uuid" type="varchar(38)"><constraints primaryKey="true" nullable="false" /></column>
            <column name="order_uuid" type="varchar(38)"><constraints nullable="false" /></column>
            <column name="encounter_uuid" type="varchar(38)"><constraints nullable="false" /></column>
            <column name="patient_uuid" type="varchar(38)"><constraints nullable="false" /></column>
            <column name="obs_uuid" type="varchar(38)" />
        </createTable>
        <createIndex tableName="synchronizationmr_order_link" indexName="syncmr_order_link_order_idx"><column name="order_uuid" /></createIndex>
    </changeSet>
    <changeSet id="synchronizationmr-20260920-order-collation" author="sihsalus" dbms="mysql,mariadb">
        <sql>ALTER TABLE synchronizationmr_order_event MODIFY origin_server_id VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL</sql>
        <sql>ALTER TABLE synchronizationmr_order_receipt MODIFY origin_server_id VARCHAR(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL</sql>
    </changeSet>
</databaseChangeLog>
 
