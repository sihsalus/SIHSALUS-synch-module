<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">
	
	<!-- Base Module Properties -->
	<id>synchronizationmr</id>
	<name>SynchronizationMR</name>
	<version>1.0.0-SNAPSHOT</version>
	<package>org.openmrs.module.synchronizationmr</package>
	<author>PC</author>
	<description>
			no description
	</description>

	<activator>org.openmrs.module.synchronizationmr.SynchronizationMRActivator</activator>
	
	<!-- <updateURL>https://modules.openmrs.org/modules/download/synchronizationmr/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->
	
	<require_version>2.4.2</require_version>

    <servlet>
        <servlet-name>patientSync</servlet-name>
        <servlet-class>org.openmrs.module.synchronizationmr.web.PatientSyncHttpServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>encounterSync</servlet-name>
        <servlet-class>org.openmrs.module.synchronizationmr.web.EncounterSyncHttpServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>orderSync</servlet-name>
        <servlet-class>org.openmrs.module.synchronizationmr.web.OrderSyncHttpServlet</servlet-class>
    </servlet>
    <advice>
        <point>org.openmrs.api.OrderService</point>
        <class>org.openmrs.module.synchronizationmr.advice.OrderCreationAdvice</class>
    </advice>
    <globalProperty>
        <property>synchronizationmr.nodeRole</property>
        <defaultValue>UNCONFIGURED</defaultValue>
        <description>Rol de esta instalación: MASTER o POSTA. Debe configurarse para habilitar la comunicación autenticada.</description>
    </globalProperty>
    <globalProperty>
        <property>server.id</property>
        <defaultValue></defaultValue>
        <description>Identificador único del establecimiento (por ejemplo testServer_1). Configurar el mismo valor que en el SDK; no se importa automáticamente de sus archivos. De 1 a 100 letras ASCII, números, puntos, guiones o guiones bajos, empezando por letra o número. Es la única identidad del nodo; configurar antes de registrar datos y no cambiarla después.</description>
    </globalProperty>

    <advice>
        <point>org.openmrs.api.PatientService</point>
        <class>org.openmrs.module.synchronizationmr.advice.PatientCreationAdvice</class>
    </advice>
    <advice>
        <point>org.openmrs.api.EncounterService</point>
        <class>org.openmrs.module.synchronizationmr.advice.EncounterCreationAdvice</class>
    </advice>
    <privilege>
        <name>Receive Synchronization Records</name>
        <description>Recibir eventos de sincronización de pacientes y encuentros de otros nodos.</description>
    </privilege>
    <privilege>
        <name>Prepare Synchronization Records</name>
        <description>Preparar la identidad y el evento de sincronización de un paciente local preexistente.</description>
    </privilege>
    <privilege>
        <name>View Synchronization Records</name>
        <description>Consultar identidades de sincronización y eventos pendientes sin datos personales del paciente.</description>
    </privilege>
	
	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>
	
	
