	<!-- Internacionalización -->
	<!-- Todos los códigos de mensajes deben comenzar con synchronizationmr.* -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<messages>
		<lang>fr</lang>
		<file>messages_fr.properties</file>
	</messages>
